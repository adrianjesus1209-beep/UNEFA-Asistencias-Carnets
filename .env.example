# configuracion de la conexion de la base de datos #

# conexion para mysql | pgsql | sqlite | sqlsrv #

# APP #
APP_NAME="Unefa"
APP_URL=http://localhost/UNEFA-Asistencias-Carnets
APP_BASE_PATH=/UNEFA-Asistencias-Carnets

# base de datos #
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE= 
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# correo #
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=Sistema de asistencias y carnets

#  JWT #
JWT_SECRET=clave_secreta_local_cambiar_en_produccion

